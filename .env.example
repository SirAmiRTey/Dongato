# ==============================================================================
# DONGATO (دنگاتو) - Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Host & Port Configuration
# ------------------------------------------------------------------------------
# The port on the host VPS that will be mapped to the Nginx frontend container
APP_PORT=3000

# ------------------------------------------------------------------------------
# 2. Self-Hosted PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Standard Docker internal networking host pointing to the 'db' container
DB_HOST=db
DB_PORT=5432
DB_NAME=dongato
DB_USER=postgres
# In production, replace with a strong, randomized alphanumeric password
DB_PASSWORD=dongato_secure_password_replace_in_prod

# ------------------------------------------------------------------------------
# 3. PostgREST API Engine & JWT Security
# ------------------------------------------------------------------------------
# Shared secret for signing and validating JWT tokens (MUST be >= 32 characters)
JWT_SECRET=super-secret-jwt-token-dongato-production-32-chars-long

# ------------------------------------------------------------------------------
# 4. Client-Facing API Configuration (Vite Runtime / Build)
# ------------------------------------------------------------------------------
# URL where your client browser will reach the API.
# For local VPS testing, use http://localhost:3000 or http://<VPS_IP>:3000.
# For production with a custom domain, use https://dongato.yourdomain.com.
VITE_SUPABASE_URL=http://localhost:3000

# Public Anonymous Client Key (PostgREST anon token)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyZWZlcmVuY2UiOiJkb25nYXRvIiwicm9sZSI6ImFub24iLCJpYXQiOjE2MDAwMDAwMDAsImV4cCI6MTkwMDAwMDAwMH0.signature
